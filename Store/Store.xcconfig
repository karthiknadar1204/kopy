PRODUCT_NAME = Kopy
PRODUCT_BUNDLE_IDENTIFIER = com.karthiknadar.kopy
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
INFOPLIST_FILE = Info.plist
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = Kopy.entitlements
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
SKIP_INSTALL = NO
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) KOPY_APP_STORE
EXCLUDED_SOURCE_FILE_NAMES = KopyUpdater.swift KopyUpdateSection.swift
OTHER_LDFLAGS = $(inherited) -lsqlite3
