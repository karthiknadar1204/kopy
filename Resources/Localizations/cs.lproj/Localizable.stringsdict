<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld images</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld obrázky</string>
			<key>many</key>
			<string>%lld obrázku</string>
			<key>one</key>
			<string>%lld obrázek</string>
			<key>other</key>
			<string>%lld obrázků</string>
		</dict>
	</dict>
	<key>Saved %lld images to Downloads</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Uloženy %lld obrázky do Stažených souborů</string>
			<key>many</key>
			<string>Uloženo %lld obrázku do Stažených souborů</string>
			<key>one</key>
			<string>Uložen %lld obrázek do Stažených souborů</string>
			<key>other</key>
			<string>Uloženo %lld obrázků do Stažených souborů</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld položky</string>
			<key>one</key>
			<string>%lld položka</string>
			<key>other</key>
			<string>%lld položek</string>
		</dict>
	</dict>
</dict>
</plist>
