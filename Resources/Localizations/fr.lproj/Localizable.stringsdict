<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld images</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>many</key>
			<string>%lld d'images</string>
			<key>one</key>
			<string>%lld image</string>
			<key>other</key>
			<string>%lld images</string>
		</dict>
	</dict>
	<key>Saved %lld images to Downloads</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>many</key>
			<string>%lld d'images enregistrées dans Téléchargements</string>
			<key>one</key>
			<string>%lld image enregistrée dans Téléchargements</string>
			<key>other</key>
			<string>%lld images enregistrées dans Téléchargements</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld élément</string>
			<key>other</key>
			<string>%lld éléments</string>
		</dict>
	</dict>
</dict>
</plist>
