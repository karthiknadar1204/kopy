<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld images</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld obrazy</string>
			<key>many</key>
			<string>%lld obrazów</string>
			<key>one</key>
			<string>%lld obraz</string>
			<key>other</key>
			<string>%lld obrazu</string>
		</dict>
	</dict>
	<key>Saved %lld images to Downloads</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Zapisano %lld obrazy w Pobranych</string>
			<key>many</key>
			<string>Zapisano %lld obrazów w Pobranych</string>
			<key>one</key>
			<string>Zapisano %lld obraz w Pobranych</string>
			<key>other</key>
			<string>Zapisano %lld obrazu w Pobranych</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld elementy</string>
			<key>many</key>
			<string>%lld elementów</string>
			<key>one</key>
			<string>%lld element</string>
			<key>other</key>
			<string>%lld elementów</string>
		</dict>
	</dict>
</dict>
</plist>
