<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld images</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld зображення</string>
			<key>many</key>
			<string>%lld зображень</string>
			<key>one</key>
			<string>%lld зображення</string>
			<key>other</key>
			<string>%lld зображення</string>
		</dict>
	</dict>
	<key>Saved %lld images to Downloads</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Збережено %lld зображення в «Завантаження»</string>
			<key>many</key>
			<string>Збережено %lld зображень у «Завантаження»</string>
			<key>one</key>
			<string>Збережено %lld зображення в «Завантаження»</string>
			<key>other</key>
			<string>Збережено %lld зображення в «Завантаження»</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld елементи</string>
			<key>many</key>
			<string>%lld елементів</string>
			<key>one</key>
			<string>%lld елемент</string>
			<key>other</key>
			<string>%lld елементів</string>
		</dict>
	</dict>
</dict>
</plist>
