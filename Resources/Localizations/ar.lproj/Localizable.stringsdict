<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld images</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld صور</string>
			<key>many</key>
			<string>%lld صورة</string>
			<key>one</key>
			<string>%lld صورة</string>
			<key>other</key>
			<string>%lld صورة</string>
			<key>two</key>
			<string>%lld صورتان</string>
			<key>zero</key>
			<string>%lld صورة</string>
		</dict>
	</dict>
	<key>Saved %lld images to Downloads</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>تم حفظ %lld صور في التنزيلات</string>
			<key>many</key>
			<string>تم حفظ %lld صورة في التنزيلات</string>
			<key>one</key>
			<string>تم حفظ %lld صورة في التنزيلات</string>
			<key>other</key>
			<string>تم حفظ %lld صورة في التنزيلات</string>
			<key>two</key>
			<string>تم حفظ %lld صورتين في التنزيلات</string>
			<key>zero</key>
			<string>تم حفظ %lld صورة في التنزيلات</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld عناصر</string>
			<key>many</key>
			<string>%lld عنصرًا</string>
			<key>one</key>
			<string>عنصر واحد</string>
			<key>other</key>
			<string>%lld عنصر</string>
			<key>two</key>
			<string>عنصران</string>
			<key>zero</key>
			<string>لا عناصر</string>
		</dict>
	</dict>
</dict>
</plist>
