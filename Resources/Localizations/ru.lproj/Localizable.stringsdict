<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld images</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld изображения</string>
			<key>many</key>
			<string>%lld изображений</string>
			<key>one</key>
			<string>%lld изображение</string>
			<key>other</key>
			<string>%lld изображения</string>
		</dict>
	</dict>
	<key>Saved %lld images to Downloads</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Сохранено %lld изображения в «Загрузки»</string>
			<key>many</key>
			<string>Сохранено %lld изображений в «Загрузки»</string>
			<key>one</key>
			<string>Сохранено %lld изображение в «Загрузки»</string>
			<key>other</key>
			<string>Сохранено %lld изображения в «Загрузки»</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld элемента</string>
			<key>many</key>
			<string>%lld элементов</string>
			<key>one</key>
			<string>%lld элемент</string>
			<key>other</key>
			<string>%lld элементов</string>
		</dict>
	</dict>
</dict>
</plist>
